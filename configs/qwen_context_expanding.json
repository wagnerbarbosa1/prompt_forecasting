{
  "datasets": {
    "joinville": {
      "path": "data/processed/joinville_processed_1day.csv",
      "context": 365,
      "numerical_covariates": [
        "precipitation_median",
        "temperature_2m_previsao_mean",
        "shortwave_radiation_previsao_std",
        "day",
        "dayofweek_sin",
        "dayofweek_cos",
        "season_sin",
        "season_cos"
      ],
      "categorical_covariates": [
        "is_holiday"
      ]
    },
    "guaratuba": {
      "path": "data/processed/guaratuba_processed_1daysin.csv",
      "context": 730,
      "numerical_covariates": [
        "relative_humidity_mean",
        "temperature_mean",
        "radiation_mean",
        "precipitation_mean",
        "day",
        "dayofweek_sin",
        "dayofweek_cos",
        "season_sin",
        "season_cos"
      ],
      "categorical_covariates": [
        "is_holiday_ctba_gtba_jve",
        "is_weekend",
        "is_carnival",
        "is_school_recess_pr"
      ]
    }
  },
  "horizon": 7,
  "step": 7,
  "validation_fraction": 0.2,
  "seed": 42,
  "qwen": {
    "model": "qwen3:4b-instruct-2507-q4_K_M",
    "base_url": "http://127.0.0.1:11435",
    "temperature": 0,
    "num_ctx": 131072,
    "num_predict": 256,
    "timeout": 7200,
    "retries": 1
  },
  "strategy": "zero",
  "few_shot_examples": 3,
  "qwen_history_days": null,
  "future_covariates_policy": "supplied CSV values, as in original scripts; availability at forecast origin is an unverified input assumption",
  "runtime": {
    "ollama_flash_attention": true,
    "ollama_kv_cache_type": "q4_0",
    "ollama_num_parallel": 1,
    "llama_arg_cache_ram": 0
  },
  "prompt_layout": "tabular"
}
