{
  "datasets": {
    "joinville": {
      "path": "data/processed/calendar_text/joinville_processed_1day_calendar_text.csv",
      "context": 365,
      "numerical_covariates": [
        "precipitation_median",
        "temperature_2m_previsao_mean",
        "shortwave_radiation_previsao_std"
      ],
      "categorical_covariates": [
        "is_holiday",
        "day",
        "dayofweek",
        "season"
      ],
      "textual_calendar": true
    },
    "guaratuba": {
      "path": "data/processed/calendar_text/guaratuba_processed_1daysin_calendar_text.csv",
      "context": 730,
      "numerical_covariates": [
        "relative_humidity_mean",
        "temperature_mean",
        "radiation_mean",
        "precipitation_mean"
      ],
      "categorical_covariates": [
        "is_holiday_ctba_gtba_jve",
        "is_weekend",
        "is_carnival",
        "is_school_recess_pr",
        "day",
        "dayofweek",
        "season"
      ],
      "textual_calendar": true
    }
  },
  "horizon": 7,
  "step": 7,
  "validation_fraction": 0.2,
  "seed": 42,
  "qwen": {
    "model": "qwen3:1.7b",
    "base_url": "http://127.0.0.1:11435",
    "temperature": 0,
    "num_ctx": 16384,
    "num_predict": 256,
    "timeout": 600,
    "retries": 2
  },
  "strategy": "zero",
  "few_shot_examples": 3,
  "qwen_history_days": 7,
  "future_covariates_policy": "supplied CSV values, as in original scripts; availability at forecast origin is an unverified input assumption"
}
