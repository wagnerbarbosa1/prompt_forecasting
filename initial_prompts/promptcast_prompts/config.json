{
  "lookback_days": 14,
  "horizons": [
    7
  ],
  "evaluation_years": 2,
  "step": 7,
  "few_shot_examples": 3,
  "random_seed": 42,
  "min_demo_gap": 0,
  "scenarios": {
    "s1": "demand",
    "s2": "demand_calendar",
    "s3": "demand_calendar_weather"
  },
  "strategies": {
    "zero": 0,
    "few_random": 3,
    "few_similar": 3
  },
  "input_columns": [
    "timestamp",
    "water_produced",
    "temperature_mean",
    "radiation_mean",
    "relative_humidity_mean",
    "precipitation_mean"
  ],
  "std_columns_excluded": [
    "temperature_std",
    "radiation_std",
    "relative_humidity_std",
    "precipitation_std"
  ],
  "leakage_policy": {
    "future_demand": "never included in current prompt",
    "future_weather": "included in S3 as meteorological forecasts for target dates",
    "future_calendar": "allowed because deterministic/known in advance",
    "few_shot_targets": "allowed only when their complete target is historical relative to the current forecast origin",
    "similarity_features": "input window only; demonstration future targets are never used for selection"
  }
}